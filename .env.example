# --- legacy bot (still live until cutover) ---
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_CHAT_ID=your_admin_telegram_id_here
APP_TIMEZONE=Australia/Sydney

# --- new stack ---
# Neon pooled connection string. postgresql:// is rewritten to
# postgresql+psycopg:// automatically.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public https origin, used to build the Telegram sign-in link.
PUBLIC_URL=https://shrimpzone-timetracker.fly.dev

# Long random strings. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=change_me
SESSION_SECRET=change_me

# en or vi. Staff-facing strings exist in both.
APP_LANGUAGE=en

# Set to 0 only for local http development.
COOKIE_SECURE=1
